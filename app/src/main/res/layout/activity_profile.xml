<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".ProfileActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:alpha="0.34"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_auth" />

    <View
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@drawable/profile_header_fade" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/profile_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="130dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/profile_settings_icon"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="82dp"
                        android:layout_height="82dp"
                        android:background="@drawable/profile_avatar_background"
                        android:contentDescription="@string/profile_label"
                        android:padding="18dp"
                        android:src="@drawable/profile"
                        android:tint="@color/auth_text_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/profile_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/profile_default_name"
                            android:textColor="@color/auth_text_primary"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/profile_mode_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/profile_chip_background"
                            android:paddingStart="12dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="5dp"
                            android:text="@string/standard_mode_label"
                            android:textColor="@color/netflix_red"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/profile_email"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/auth_text_secondary"
                            android:textSize="15sp"
                            tools:text="user@email.com" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/profile_settings_icon"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/auth_back_button_background"
                    android:contentDescription="@string/profile_settings"
                    android:padding="10dp"
                    android:src="@drawable/settings"
                    android:tint="@color/auth_text_primary" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/profile_card_background"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_account"
                    android:textColor="@color/auth_text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/profile_account_name"
                    style="@style/ProfileAccountValue"
                    android:layout_marginTop="16dp"
                    tools:text="User" />

                <TextView
                    android:id="@+id/profile_account_email"
                    style="@style/ProfileAccountValue"
                    tools:text="user@email.com" />

                <TextView
                    android:id="@+id/profile_account_age"
                    style="@style/ProfileAccountValue"
                    tools:text="24" />

                <TextView
                    android:id="@+id/profile_account_mode"
                    style="@style/ProfileAccountValue"
                    tools:text="Standard Mode" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/profile_watchlist"
                android:textColor="@color/auth_text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/profile_watchlist_empty"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/profile_card_background"
                android:gravity="center"
                android:text="@string/profile_watchlist_empty"
                android:textColor="@color/auth_text_secondary"
                android:textSize="15sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/profile_watchlist_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/favorites_label"
                android:textColor="@color/auth_text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/profile_favorites_empty"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/profile_card_background"
                android:gravity="center"
                android:text="@string/profile_favorites_empty"
                android:textColor="@color/auth_text_secondary"
                android:textSize="15sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/profile_favorites_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/profile_favorite_genres"
                android:textColor="@color/auth_text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ProfileGenreChip"
                        android:text="@string/genre_action" />

                    <TextView
                        style="@style/ProfileGenreChip"
                        android:text="@string/genre_drama" />

                    <TextView
                        style="@style/ProfileGenreChip"
                        android:text="@string/genre_thriller" />

                    <TextView
                        style="@style/ProfileGenreChip"
                        android:text="@string/genre_scifi" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/profile_recently_watched"
                android:textColor="@color/auth_text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/ProfileRecentCard">

                        <ImageView
                            android:layout_width="116dp"
                            android:layout_height="130dp"
                            android:background="@drawable/movie_poster_placeholder"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop" />

                        <ProgressBar
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="116dp"
                            android:layout_height="5dp"
                            android:layout_marginTop="10dp"
                            android:max="100"
                            android:progress="62"
                            android:progressBackgroundTint="#44FFFFFF"
                            android:progressTint="@color/netflix_red" />
                    </LinearLayout>

                    <LinearLayout style="@style/ProfileRecentCard">

                        <ImageView
                            android:layout_width="116dp"
                            android:layout_height="130dp"
                            android:background="@drawable/movie_poster_placeholder"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop" />

                        <ProgressBar
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="116dp"
                            android:layout_height="5dp"
                            android:layout_marginTop="10dp"
                            android:max="100"
                            android:progress="36"
                            android:progressBackgroundTint="#44FFFFFF"
                            android:progressTint="@color/netflix_red" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/profile_card_background"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_settings"
                    android:textColor="@color/auth_text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/ProfileSettingsRow"
                    android:text="@string/settings_account" />

                <TextView
                    style="@style/ProfileSettingsRow"
                    android:text="@string/settings_notifications" />

                <TextView
                    style="@style/ProfileSettingsRow"
                    android:text="@string/settings_language" />

                <TextView
                    style="@style/ProfileSettingsRow"
                    android:text="@string/settings_privacy" />

                <TextView
                    style="@style/ProfileSettingsRow"
                    android:text="@string/settings_help" />
            </LinearLayout>

            <TextView
                android:id="@+id/profile_logout_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/profile_logout_button_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/logout"
                android:textColor="@color/auth_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/profile_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/home_bottom_nav_background"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp"
        android:weightSum="4">

        <LinearLayout
            android:id="@+id/profile_nav_home"
            style="@style/ProfileNavItem">

            <ImageView
                style="@style/ProfileNavIcon"
                android:contentDescription="@string/home_label"
                android:src="@drawable/play"
                android:tint="@color/home_nav_inactive" />

            <TextView
                style="@style/ProfileNavLabel"
                android:text="@string/home_label"
                android:textColor="@color/home_nav_inactive" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profile_nav_search"
            style="@style/ProfileNavItem">

            <ImageView
                style="@style/ProfileNavIcon"
                android:contentDescription="@string/search_label"
                android:src="@drawable/search"
                android:tint="@color/home_nav_inactive" />

            <TextView
                style="@style/ProfileNavLabel"
                android:text="@string/search_label"
                android:textColor="@color/home_nav_inactive" />
        </LinearLayout>

        <LinearLayout style="@style/ProfileNavItem">

            <ImageView
                style="@style/ProfileNavIcon"
                android:contentDescription="@string/favorites_label"
                android:src="@drawable/heart"
                android:tint="@color/home_nav_inactive" />

            <TextView
                style="@style/ProfileNavLabel"
                android:text="@string/favorites_label"
                android:textColor="@color/home_nav_inactive" />
        </LinearLayout>

        <LinearLayout style="@style/ProfileNavItem">

            <ImageView
                style="@style/ProfileNavIcon"
                android:contentDescription="@string/profile_label"
                android:src="@drawable/profile"
                android:tint="@color/netflix_red" />

            <TextView
                style="@style/ProfileNavLabel"
                android:text="@string/profile_label"
                android:textColor="@color/netflix_red" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
